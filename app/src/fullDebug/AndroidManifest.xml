<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Only the selected launcher icon is enabled. Its singleTop activity keeps
             the active profile and receives app-specific search on the current task. -->
        <activity android:name=".launcher.AppIconDefault">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <action android:name="com.google.android.gms.actions.SEARCH_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.app.searchable" android:resource="@xml/discover_searchable" />
        </activity>

